DB_URL=postgresql+psycopg://app:change-me@db:5432/app
ES_URL=http://elasticsearch:9200
POSTGRES_DB=app
POSTGRES_USER=app
POSTGRES_PASSWORD=change-me
API_URL=http://localhost:8000
VITE_API_URL=/api
FRONTEND_URL=http://localhost:5173
ES_INDEX_SHARDS=1
ES_INDEX_REPLICAS=0
WAZUH_INDEX_PREFIX=wazuh-alerts
WAZUH_RETENTION_DAYS=90

# Production readiness
AUTH_ENABLED=false
API_KEY=replace-with-a-long-random-secret
VITE_API_KEY=
LOG_LEVEL=INFO
SERVICE_NAME=backend
AUDIT_RETENTION_DAYS=180
APP_LOG_RETENTION_DAYS=30
ERROR_RETENTION_DAYS=90
BACKGROUND_JOB_INTERVAL_SEC=300
INGEST_WORKER_INTERVAL_SEC=5
INGEST_WORKER_BATCH_SIZE=25
DEMO_MODE=false
DEMO_SEED_ON_STARTUP=false
